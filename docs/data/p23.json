{
 "section": "02 함수의 연속 (개념 확인 문제)",
 "problems": [
  {
   "no": "01",
   "answer": "\\text{불연속}",
   "steps": [
    {
     "tex": "f(1)\\text{ 이 정의되지 않음 (빈 원)}\\Rightarrow x=1\\text{ 에서 불연속}"
    }
   ]
  },
  {
   "no": "02",
   "answer": "\\text{불연속}",
   "steps": [
    {
     "tex": "\\lim_{x\\to1-}f(x)=1\\ne\\lim_{x\\to1+}f(x)=2\\Rightarrow\\lim_{x\\to1}f(x)\\text{ 없음}"
    }
   ]
  },
  {
   "no": "03",
   "answer": "\\text{불연속}",
   "steps": [
    {
     "tex": "\\lim_{x\\to1}f(x)=0\\ne f(1)=2"
    }
   ]
  },
  {
   "no": "04",
   "answer": "\\text{연속}",
   "steps": [
    {
     "tex": "\\lim_{x\\to1}f(x)=1=f(1)"
    }
   ]
  },
  {
   "no": "05",
   "answer": "\\text{불연속}",
   "steps": [
    {
     "tex": "\\lim_{x\\to1-}(x+1)=2,\\quad\\lim_{x\\to1+}(2x-1)=1\\Rightarrow\\text{극한 없음}"
    }
   ]
  },
  {
   "no": "06",
   "answer": "\\text{연속}",
   "steps": [
    {
     "tex": "\\lim_{x\\to1-}(x^2-1)=0,\\quad\\lim_{x\\to1+}(2x-2)=0,\\quad f(1)=0"
    }
   ]
  },
  {
   "no": "07",
   "answer": "\\text{불연속}",
   "steps": [
    {
     "tex": "\\lim_{x\\to1-}\\frac1{x-1}=-\\infty,\\ \\lim_{x\\to1+}\\frac1{x-1}=\\infty\\Rightarrow\\text{극한 없음}"
    }
   ]
  },
  {
   "no": "08",
   "answer": "\\text{연속}",
   "steps": [
    {
     "tex": "\\lim_{x\\to1}\\frac{(x-1)(x+1)}{x-1}=\\lim_{x\\to1}(x+1)=2=f(1)"
    }
   ]
  },
  {
   "no": "09",
   "answer": "\\text{연속}",
   "steps": [
    {
     "tex": "\\lim_{x\\to1-}(-x+1)=0,\\quad\\lim_{x\\to1+}\\sqrt{x-1}=0,\\quad f(1)=0"
    }
   ]
  },
